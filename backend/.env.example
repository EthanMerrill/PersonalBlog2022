# Server Configuration
PORT=8080
ALLOWED_ORIGINS=https://ethanmerrill.com,https://Other.com # Allowed origins for CORS (comma-separated list)

# API Keys (required)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Model used by POST /api/chat. gpt-3.5-turbo is deprecated.
OPENAI_MODEL=gpt-4o-mini

# Rate limiting (per client IP, keyed on CF-Connecting-IP / X-Forwarded-For)
# Applies to POST /api/chat. Set RATE_LIMIT_PER_MINUTE=0 to disable.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
# Caps total traffic across all IPs, bounding OpenAI spend if a credential leaks.
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# Add more API keys as needed
# OTHER_SERVICE_API_KEY=your-other-service-key-here
