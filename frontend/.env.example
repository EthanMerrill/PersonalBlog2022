# Environment variables for the frontend application
# Copy this file to .env.local and fill in your values

# Backend Secrets Service URL
# For local development, use localhost
# For production, use your deployed EC2 instance URL
NEXT_PUBLIC_SECRETS_SERVICE_URL=https://portfolio.merrill-api.com
NEXT_PUBLIC_SECRETS_SERVICE_USERNAME=example_user
NEXT_PUBLIC_SECRETS_SERVICE_PASSWORD=changeme_strong_password


# Example for production:
# NEXT_PUBLIC_SECRETS_SERVICE_URL=https://portfolio.merrill-api.com

# Note: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# See: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
