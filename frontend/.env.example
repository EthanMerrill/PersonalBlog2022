# Environment variables for the frontend application
# Copy this file to .env.local and fill in your values.
#
# NOTE: every NEXT_PUBLIC_* variable is inlined into the browser bundle and is
# therefore PUBLIC. Never put credentials or API keys here — the chat API keeps
# its keys server-side.

# Base URL of the chat API (no credentials required)
NEXT_PUBLIC_SECRETS_SERVICE_URL=https://portfolio.merrill-api.com
