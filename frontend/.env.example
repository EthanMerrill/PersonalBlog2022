# Environment variables for the frontend application
# Copy this file to .env.local and fill in your values.
#
# NOTE: every NEXT_PUBLIC_* variable is inlined into the browser bundle and is
# therefore PUBLIC. Never put credentials or API keys here — the chat API keeps
# its keys server-side.

# Base URL of the chat API (no credentials required)
NEXT_PUBLIC_SECRETS_SERVICE_URL=https://portfolio.merrill-api.com

# Base URL of the PocketBase instance serving the portfolio timeline
# (collection `portfolio_timeline_items`). Read at BUILD time by app/page.tsx.
# - Set explicitly: the build FAILS if the fetch fails (a broken deploy never ships empty content).
# - Unset: the build falls back to src/api/timeline.fixture.ts and logs a warning.
# NEXT_PUBLIC_POCKETBASE_URL=https://data.merrill-api.com
